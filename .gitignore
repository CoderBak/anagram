.wxt/
output/
# The suites' build: the same code with the site patterns already granted (test/test-build.mjs).
output-test/
node_modules/
# Generated from lib/diagnostics/ before every build and on install (scripts/vendor.mjs).
# The other vendor chunks are copies of published libraries and are committed; this one is
# our own source and would go stale the moment a segmentation rule changed.
public/vendor/diagnostics.min.mjs
# Generated from the hash-verified upstream viewer under vendor/pdfjs/.
public/vendor/pdfjs/
# Copied from the hash-verified build under vendor/document-worker/ and from onnxruntime-web.
public/vendor/document-worker/
# Pinned Zotero sources and their build, kept by scripts/documentWorker.mjs.
.cache/
*.log
/:memory:.ses
.DS_Store

# test artifacts (screenshots are regenerated by the test scripts; Playwright profile)
test/*.png
test/matrix.json
test/survey.json
test/a11y.json
test/.pw-profile/
test/.unit-bundle.js

# anagramd local venv
anagramd/.venv/
__pycache__/

# release assets
dist/

# sandboxed test runs (npm run lab)
test-results/
