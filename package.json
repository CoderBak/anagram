{
  "name": "anagram-extension",
  "description": "Anagram for Chrome \u2014 per-paragraph AI-generated-text confidence badges.",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "browser": "node test/browser.mjs",
    "test:e2e": "node test/e2e.mjs",
    "postinstall": "wxt prepare",
    "test:unit": "node test/unit.mjs",
    "test:scenarios": "node test/scenarios.mjs",
    "test:perf": "node test/perf.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "play": "node test/playground.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
