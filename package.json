{
  "name": "anagram-extension",
  "description": "Local AI-editing estimates for Chrome and Firefox, powered by EditLens.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vendor.mjs && wxt",
    "build": "node scripts/vendor.mjs && wxt build",
    "build:firefox": "node scripts/vendor.mjs && wxt build -b firefox",
    "build:test": "node scripts/buildTest.mjs --all",
    "zip": "node scripts/vendor.mjs && wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:e2e": "playwright test e2e",
    "test:firefox": "npm run build:firefox && node test/pdf-viewer-firefox.mjs && node test/pdf-source-firefox.mjs && node test/firefox.mjs",
    "lint:firefox": "npm run build:firefox && node scripts/lintFirefox.mjs",
    "postinstall": "wxt prepare && node scripts/vendor.mjs",
    "test:unit": "node test/unit.mjs",
    "test:scenarios": "playwright test scenarios",
    "test:a11y": "playwright test a11y",
    "test:perf": "playwright test --project perf --no-deps",
    "zip:firefox": "node scripts/vendor.mjs && wxt zip -b firefox",
    "vendor:basecoat": "cp node_modules/basecoat-css/dist/basecoat-vega.cdn.min.css lib/ui/basecoat-vega.cdn.min.css",
    "vendor:lazy": "node scripts/vendor.mjs",
    "test:node": "vitest run",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "test:installer": "sh test/installer.sh",
    "test:runtime": "npm run build && node test/runtime.mjs",
    "test:native": "npm run build && node test/native-browser.mjs",
    "test:paste": "npm run build && playwright test paste",
    "test:pseudo-locale": "node test/pseudo-locale.mjs",
    "test:pdf-viewer": "npm run build && playwright test pdf-viewer",
    "test:pdf-install": "npm run build && playwright test pdf-install",
    "test:pdf-route": "playwright test pdf-route",
    "test:diagnostics": "playwright test diagnostics",
    "test:csp": "playwright test csp",
    "test:matrix": "node test/matrix.mjs",
    "test:backend": "sh test/backend.sh",
    "test:network-privacy": "python3 test/network-privacy.py",
    "build:oneclick": "node scripts/oneclick.mjs npm run build",
    "build:oneclick:firefox": "node scripts/oneclick.mjs npm run build:firefox",
    "build:test:oneclick": "node scripts/oneclick.mjs npm run build:test",
    "zip:oneclick": "node scripts/oneclick.mjs npm run zip",
    "zip:oneclick:firefox": "node scripts/oneclick.mjs npm run zip:firefox",
    "release:oneclick": "node scripts/oneclick.mjs npm run release",
    "typecheck:oneclick": "node scripts/oneclick.mjs npm run typecheck",
    "lint:firefox:oneclick": "node scripts/oneclick.mjs npm run lint:firefox",
    "test:oneclick": "node test/oneclick.mjs",
    "bench:pdf": "ANAGRAM_PDF_BENCH=${ANAGRAM_PDF_BENCH:-$HOME/anagram-bench/pdfbench/corpus} node test/pdf-bench/bench.mjs",
    "bench:web": "ANAGRAM_WEB_BENCH=${ANAGRAM_WEB_BENCH:-$HOME/anagram-bench/webbench/corpus} node test/web-bench/bench.mjs"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "1.61.1",
    "@puppeteer/browsers": "^3.2.2",
    "@types/culori": "^4.0.1",
    "axe-core": "^4.13.0",
    "basecoat-css": "^1.0.2",
    "culori": "^4.0.2",
    "defuddle": "^0.19.4",
    "dompurify": "^3.4.15",
    "esbuild": "^0.27.7",
    "fast-check": "^4.10.2",
    "idb": "^8.0.3",
    "linkedom": "^0.18.12",
    "onnxruntime-web": "1.27.0",
    "pdfjs-dist": "5.7.284",
    "playwright": "^1.61.1",
    "pseudo-localization": "3.1.3",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^8.1.0",
    "vitest": "^3.2.7",
    "web-ext": "10.7.0",
    "wxt": "^0.21.4"
  }
}
