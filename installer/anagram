#!/bin/sh
# anagram — control the Anagram scoring daemon installed under $ANAGRAM_HOME (~/.anagram).
#
#   anagram start | stop | restart | status | doctor | logs | selftest | model | path
#          | version | update | uninstall
#
# The daemon is an ordinary background process of your user: no launch agent, no service,
# nothing starts at login. It listens on 127.0.0.1 only and reads nothing outside this folder.
#
# Safety: the folder is derived from this script's own real location; an ANAGRAM_HOME from the
# environment is honoured only if it is a real (non-symlink) Anagram folder carrying the
# .anagram-home marker. `uninstall` re-checks all of that, refuses the roots nobody means, and
# never runs without confirmation (interactive) or -y (scripted). `doctor` only reads: it
# writes, moves and removes nothing, anywhere.
set -eu

MARKER=".anagram-home"
# Pinned by install.sh. `doctor` prefers the copy of those constants in the installer that
# actually wrote this folder (app/install.sh, read with sed — never sourced, never executed);
# these are the fallback for a folder that has no copy. Keep them in step with install.sh.
WEIGHTS_SHA256="869f33df7928c447bbd150d3b5192b4ea90b1cbd2ee4aad97f5d51d59dfc8cfb"
LID_SHA256="8f3472cfe8738a7b6099e8e999c3cbfae0dcd15696aac7d7738a8039db603e83"
PYTHON_SERIES="3.12"   # install.sh: PYTHON_VERSION=3.12.x
# The contract major the extension shipped beside this script speaks (lib/contract.ts).
CONTRACT_MAJOR="2"

# Colour only on a terminal: `anagram doctor > report.txt` and CI logs stay plain text.
if [ -t 1 ]; then
  C_G="$(printf '\033[1;32m')"; C_R="$(printf '\033[1;31m')"; C_Y="$(printf '\033[1;33m')"; C_0="$(printf '\033[0m')"
else
  C_G=""; C_R=""; C_Y=""; C_0=""
fi
if [ -t 2 ]; then E_R="$(printf '\033[1;31m')"; E_0="$(printf '\033[0m')"; else E_R=""; E_0=""; fi
say()  { printf '%s==>%s %s\n' "$C_G" "$C_0" "$*"; }
die()  { printf '%serror:%s %s\n' "$E_R" "$E_0" "$*" >&2; exit 1; }

# Resolve this script's real path (through symlinks) without GNU readlink -f.
self="$0"
n=0
while [ -L "$self" ] && [ $n -lt 16 ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
  n=$((n + 1))
done
SELF_HOME="$(cd "$(dirname "$self")/.." 2>/dev/null && pwd -P)"

is_anagram_home() {
  [ -n "$1" ] && [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/$MARKER" ]
}
if [ -n "${ANAGRAM_HOME:-}" ]; then
  is_anagram_home "$ANAGRAM_HOME" || die "ANAGRAM_HOME='$ANAGRAM_HOME' is not an Anagram folder (no $MARKER, or a symlink) — refusing to use it"
else
  ANAGRAM_HOME="$SELF_HOME"
  is_anagram_home "$ANAGRAM_HOME" || die "this script is not inside an Anagram folder ($ANAGRAM_HOME has no $MARKER)"
fi
case "$ANAGRAM_HOME" in
  /*) ;;
  *) die "ANAGRAM_HOME must be absolute" ;;
esac
case "$ANAGRAM_HOME" in
  "${HOME:-/nonexistent}"|/|/usr|/usr/local|/opt|/etc|/var|/tmp|/private/tmp|/Users|/home|/Applications|/Library|/System)
    die "refusing to operate on '$ANAGRAM_HOME'" ;;
esac

PY="$ANAGRAM_HOME/venv/bin/python"
APP="$ANAGRAM_HOME/app/serve.py"
MODEL_DIR="$ANAGRAM_HOME/models/editlens_roberta-large"
LID="$ANAGRAM_HOME/models/lid.176.ftz"
PIDFILE="$ANAGRAM_HOME/run/anagramd.pid"
LOG="$ANAGRAM_HOME/logs/anagramd.log"
PORT=8765
if [ -f "$ANAGRAM_HOME/config" ]; then
  # config holds `PORT=<digits>` only; never sourced as shell.
  cfg_port="$(sed -n 's/^PORT=\([0-9][0-9]*\)$/\1/p' "$ANAGRAM_HOME/config" | head -n 1)"
  [ -n "$cfg_port" ] && PORT="$cfg_port"
fi
HEALTH="http://127.0.0.1:$PORT/health"

# A scrubbed environment for the daemon and the downloader: inherited PYTHONPATH & co.
# cannot hijack them, and every library's side files stay inside the folder.
clean_env() {
  env -i HOME="$HOME" PATH="/usr/bin:/bin:/usr/sbin:/sbin" LANG="${LANG:-C.UTF-8}" \
    HF_HOME="$ANAGRAM_HOME/hf" HF_HUB_DISABLE_TELEMETRY=1 XDG_CACHE_HOME="$ANAGRAM_HOME/cache" \
    TOKENIZERS_PARALLELISM=false PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 \
    ${http_proxy:+http_proxy="$http_proxy"} ${https_proxy:+https_proxy="$https_proxy"} ${no_proxy:+no_proxy="$no_proxy"} \
    ${HTTP_PROXY:+HTTP_PROXY="$HTTP_PROXY"} ${HTTPS_PROXY:+HTTPS_PROXY="$HTTPS_PROXY"} ${NO_PROXY:+NO_PROXY="$NO_PROXY"} \
    ${SSL_CERT_FILE:+SSL_CERT_FILE="$SSL_CERT_FILE"} ${REQUESTS_CA_BUNDLE:+REQUESTS_CA_BUNDLE="$REQUESTS_CA_BUNDLE"} \
    "$@"
}

sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -c1-64; }
alive() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
healthy() { curl -fsS -m 2 "$HEALTH" >/dev/null 2>&1; }
short() { printf '%.12s…' "$1"; }

# One scalar out of ONE small JSON object we produced ourselves (/health). Not a parser and
# not meant to be one: it never runs anything, and the worst a hostile answer can do is make
# a line of `doctor` read oddly. "" when the key is missing or null.
json_str() { printf '%s' "$1" | tr -d '\n' | sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'; }
json_num() { printf '%s' "$1" | tr -d '\n' | sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'; }

# Modification time in seconds since the epoch. GNU stat first: BSD's -f takes a format too,
# but GNU's -f means --file-system, so asking BSD-style first would silently answer nonsense.
mtime_of() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || true; }

# Is ANYTHING listening on our port? curl's exit 7 is "connection refused" — that, and only
# that, means the port is free. Nothing is written: the request is answered into /dev/null.
port_busy() {
  rc=0
  curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/" >/dev/null 2>&1 || rc=$?
  [ "$rc" -ne 7 ]
}

# The checksum install.sh pinned for $1, taken from the installer's own copy inside this
# folder when there is one. The file is read, never sourced: one sed pattern that accepts
# nothing but 64 hex characters.
pinned() {
  _f="$ANAGRAM_HOME/app/install.sh"; _v=""
  if [ -f "$_f" ] && [ ! -L "$_f" ]; then
    _v="$(sed -n "s/^$1=\"\([0-9a-f]\{64\}\)\".*/\1/p" "$_f" 2>/dev/null | head -n 1 || true)"
  fi
  [ -n "$_v" ] || _v="$2"
  printf '%s' "$_v"
}

cmd_status() {
  if healthy; then
    clean_env HEALTH_JSON="$(curl -fsS -m 2 "$HEALTH")" "$PY" - <<'PYEOF'
import json, os
d = json.loads(os.environ["HEALTH_JSON"])
m = d["model"]
print(f"running · {m['id']} {m['ver']} · {d['device']} {d.get('dtype', '')} · language gate {d.get('lid') or 'OFF'}"
      f" · {d['scored_blocks']} paragraphs scored · up {int(d['uptime_s'])} s")
PYEOF
    echo "    http://127.0.0.1:$PORT  ·  log: $LOG"
    alive || echo "    (answering on the port, but not started by 'anagram start' — another daemon, e.g. npm run serve)"
  elif alive; then
    echo "starting (pid $(cat "$PIDFILE")) — not answering yet; see $LOG"
  else
    echo "not running  —  start with: $ANAGRAM_HOME/bin/anagram start"
    return 1
  fi
}

# One line: the version installed in this folder and, when the daemon answers, whether the
# process serving requests is that build. The daemon does not report the installed version —
# and serve.py is not ours to change — so the two are told apart by time: /health reports how
# long the process has been up, VERSION carries the moment the installer last wrote it. A
# VERSION newer than the process means an update landed under a daemon that is still running
# the old code in memory.
cmd_version() {
  v="$(head -n 1 "$ANAGRAM_HOME/VERSION" 2>/dev/null | tr -d ' \011\015' || true)"
  [ -n "$v" ] || v="unknown"
  health="$(curl -fsS -m 2 "$HEALTH" 2>/dev/null || true)"
  if [ -z "$health" ]; then
    printf '%s  ·  daemon not running\n' "$v"
    return 0
  fi
  up="$(json_num "$health" uptime_s)"
  stamp="$(mtime_of "$ANAGRAM_HOME/VERSION")"
  if [ -n "$up" ] && [ -n "$stamp" ] && [ "$stamp" -gt "$(( $(date +%s) - up ))" ]; then
    printf '%s  ·  the daemon started before this version was installed — restart to run the updated daemon\n' "$v"
  else
    printf '%s  ·  daemon running this build (up %s s)\n' "$v" "${up:-?}"
  fi
}

# One generation of rotation before each start: every start appends to the same file, and
# nothing else ever trims it. The rotation is skipped silently when logs/, the log or the
# existing .1 is a symbolic link — this script writes only inside the validated $ANAGRAM_HOME,
# and any of those links would move the bytes (or the mv) somewhere nobody asked for.
rotate_log() {
  if [ ! -f "$LOG" ] || [ -L "$ANAGRAM_HOME/logs" ] || [ -L "$LOG" ] || [ -L "$LOG.1" ]; then
    return 0
  fi
  bytes="$(wc -c < "$LOG")"
  if [ "$((bytes))" -gt 5242880 ]; then
    mv "$LOG" "$LOG.1"
    say "Log was over 5 MB — the previous one is now $LOG.1"
  fi
}

cmd_start() {
  [ -x "$PY" ] || die "no daemon environment in $ANAGRAM_HOME — run the installer again"
  [ -f "$MODEL_DIR/config.json" ] || die "no checkpoint in $MODEL_DIR — run: $ANAGRAM_HOME/bin/anagram model"
  if healthy; then say "already running"; cmd_status; return 0; fi
  if alive; then say "already starting (pid $(cat "$PIDFILE"))"; return 0; fi
  rotate_log
  say "Starting anagramd on 127.0.0.1:$PORT"
  clean_env HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    nohup "$PY" "$APP" --model-dir "$MODEL_DIR" --lid-model "$LID" --host 127.0.0.1 --port "$PORT" >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  i=0
  while [ $i -lt 120 ]; do
    if healthy; then cmd_status; return 0; fi
    if ! alive; then die "the daemon exited — last lines of $LOG:
$(tail -n 20 "$LOG")"; fi
    sleep 1; i=$((i + 1))
  done
  die "still not answering after 120 s — see $LOG"
}

cmd_stop() {
  if alive; then
    pid="$(cat "$PIDFILE")"
    say "Stopping anagramd (pid $pid)"
    kill "$pid" 2>/dev/null || true
    i=0; while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.5; i=$((i + 1)); done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  else
    # Only a daemon running THIS folder's serve.py qualifies.
    pkill -f "$PY $APP" 2>/dev/null && say "Stopped a daemon started outside 'anagram start'" || echo "not running"
  fi
  rm -f "$PIDFILE"
}

cmd_model() {
  [ -x "$PY" ] || die "run the installer first"
  TOKEN="${ANAGRAM_HF_TOKEN:-}"
  if [ -z "$TOKEN" ] && [ -t 0 ]; then
    echo "The EditLens checkpoint is gated on Hugging Face: accept its terms at"
    echo "https://huggingface.co/pangram/editlens_roberta-large and paste a read token."
    printf 'token: '; read -r TOKEN
  fi
  [ -n "$TOKEN" ] || die "set ANAGRAM_HF_TOKEN=… or run interactively"
  say "Downloading the EditLens checkpoint into $MODEL_DIR"
  clean_env HF_TOKEN="$TOKEN" "$PY" - "$MODEL_DIR" <<'PYEOF'
import sys
from huggingface_hub import snapshot_download
snapshot_download("pangram/editlens_roberta-large", revision="f93e1ace74528cfb48f337ab2fe946fb71a728cb", local_dir=sys.argv[1], allow_patterns=["*.json", "*.txt", "*.safetensors", "README.md"])
PYEOF
  if [ ! -f "$LID" ]; then
    curl -fsSL --retry 3 -o "$LID.part" https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.ftz
    [ "$(sha256_of "$LID.part")" = "8f3472cfe8738a7b6099e8e999c3cbfae0dcd15696aac7d7738a8039db603e83" ] || die "checksum mismatch for lid.176.ftz"
    mv "$LID.part" "$LID"
  fi
  say "done"
}

# ---------------------------------------------------------------------------- doctor
# Every failure of a local daemon looks the same from the extension ("Daemon not running"),
# so this is the one command that says WHICH thing is wrong, in the order a working install
# depends on them. It is strictly read-only: no file is created, written, moved or removed,
# no process is started or signalled, and nothing reaches the network (the only request is to
# our own port on 127.0.0.1). The Python probe runs under the same scrubbed environment as the
# daemon, with PYTHONDONTWRITEBYTECODE so an import cannot even leave a .pyc behind.
DOCTOR_FAILED=0
DOCTOR_WARNED=0
chk() {
  case "$1" in
    ok)   printf '%sok%s    %-11s %s\n' "$C_G" "$C_0" "$2" "$3" ;;
    warn) printf '%swarn%s  %-11s %s\n' "$C_Y" "$C_0" "$2" "$3"; DOCTOR_WARNED=$((DOCTOR_WARNED + 1)) ;;
    *)    printf '%sFAIL%s  %-11s %s\n' "$C_R" "$C_0" "$2" "$3"; DOCTOR_FAILED=$((DOCTOR_FAILED + 1)) ;;
  esac
}
fix()  { printf '      → %s\n' "$*"; }
note() { printf '      %s\n' "$*"; }

# The packages the daemon imports, in one invocation, with no network and no bytecode written.
py_probe() {
  clean_env PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 "$PY" - <<'PYEOF' 2>/dev/null
import sys
print("version %d.%d.%d" % sys.version_info[:3])
for name in ("torch", "transformers", "fastapi", "uvicorn", "fasttext", "emoji", "huggingface_hub"):
    try:
        __import__(name)
        print("import %s ok" % name)
    except BaseException as e:
        print("import %s FAIL %s" % (name, " ".join(str(e).split())[:100]))
PYEOF
}

doctor_folder() {
  missing=""; linked=""
  for sub in app bin extension logs models run venv; do
    if [ -L "$ANAGRAM_HOME/$sub" ]; then linked="$linked $sub"
    elif [ ! -d "$ANAGRAM_HOME/$sub" ]; then missing="$missing $sub"; fi
  done
  for sub in cache hf python tools; do
    if [ -L "$ANAGRAM_HOME/$sub" ]; then linked="$linked $sub"; fi
  done
  if [ -n "$linked" ]; then
    chk FAIL folder "symbolic link inside the folder:$linked — this script never writes through one"
    fix "replace the link(s) with real directories, then: $ANAGRAM_HOME/bin/anagram update"
  elif [ -n "$missing" ]; then
    chk FAIL folder "missing sub-folder(s):$missing"
    fix "re-run the installer: $ANAGRAM_HOME/bin/anagram update"
  else
    chk ok folder "$MARKER present, not a symlink, app bin extension logs models run venv in place"
  fi
}

doctor_version() {
  v="$(head -n 1 "$ANAGRAM_HOME/VERSION" 2>/dev/null | tr -d ' \011\015' || true)"
  m="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9A-Za-z.+-]*\)".*/\1/p' \
       "$ANAGRAM_HOME/extension/manifest.json" 2>/dev/null | head -n 1 || true)"
  if [ -z "$v" ]; then
    chk FAIL version "no VERSION file — this folder was not finished by the installer"
    fix "run: $ANAGRAM_HOME/bin/anagram update"
  elif [ -z "$m" ]; then
    chk FAIL version "$v installed, but extension/manifest.json carries no version"
    fix "run: $ANAGRAM_HOME/bin/anagram update"
  elif [ "$v" != "$m" ]; then
    chk FAIL version "VERSION says $v, extension/manifest.json says $m — an update did not finish"
    fix "run: $ANAGRAM_HOME/bin/anagram update  (then reload the extension in chrome://extensions)"
  else
    chk ok version "$v — the installed extension carries the same version"
  fi
}

doctor_python() {
  if [ ! -x "$PY" ]; then
    chk FAIL python "no interpreter at venv/bin/python"
    fix "run: $ANAGRAM_HOME/bin/anagram update"
    return 0
  fi
  report="$(py_probe || true)"
  pyver="$(printf '%s\n' "$report" | sed -n 's/^version \(.*\)$/\1/p' | head -n 1)"
  if [ -z "$pyver" ]; then
    chk FAIL python "venv/bin/python did not run"
    fix "run: $ANAGRAM_HOME/bin/anagram update  (rebuilds the private Python and its packages)"
    return 0
  fi
  case "$pyver" in
    "$PYTHON_SERIES".*) chk ok python "$pyver (the pinned $PYTHON_SERIES series), private to this folder" ;;
    *) chk FAIL python "$pyver is not the pinned $PYTHON_SERIES series"
       fix "run: $ANAGRAM_HOME/bin/anagram update" ;;
  esac
  bad="$(printf '%s\n' "$report" | sed -n 's/^import \([^ ]*\) FAIL.*/\1/p' | tr '\n' ' ')"
  good="$(printf '%s\n' "$report" | sed -n 's/^import \([^ ]*\) ok$/\1/p' | tr '\n' ' ')"
  if [ -n "$bad" ]; then
    chk FAIL packages "these do not import: $(printf '%s' "$bad" | sed 's/ *$//; s/ /, /g')"
    printf '%s\n' "$report" | sed -n 's/^import \([^ ]*\) FAIL \(.*\)$/      \1: \2/p'
    fix "run: $ANAGRAM_HOME/bin/anagram update  (re-installs them from the locked versions)"
  else
    chk ok packages "$(printf '%s' "$good" | sed 's/ *$//; s/ /, /g') import"
  fi
}

doctor_models() {
  weights="$MODEL_DIR/model.safetensors"
  if [ ! -f "$MODEL_DIR/config.json" ] || [ ! -f "$weights" ]; then
    chk FAIL checkpoint "no EditLens checkpoint in ${MODEL_DIR#"$ANAGRAM_HOME"/} (config.json + model.safetensors)"
    fix "run: $ANAGRAM_HOME/bin/anagram model"
  else
    note "hashing ${weights#"$ANAGRAM_HOME"/} (1.4 GB — a few seconds) …"
    got="$(sha256_of "$weights" 2>/dev/null || true)"
    want="$(pinned WEIGHTS_SHA256 "$WEIGHTS_SHA256")"
    if [ "$got" = "$want" ]; then
      chk ok checkpoint "config.json + model.safetensors, sha256 $(short "$got") as pinned"
    else
      chk FAIL checkpoint "model.safetensors is sha256 $(short "$got"), the pinned checkpoint is $(short "$want")"
      fix "run: $ANAGRAM_HOME/bin/anagram model  (re-downloads and verifies it)"
    fi
  fi
  if [ ! -f "$LID" ]; then
    chk FAIL language-id "models/lid.176.ftz is missing — the language gate fails closed, the daemon will not start"
    fix "run: $ANAGRAM_HOME/bin/anagram model"
  else
    got="$(sha256_of "$LID" 2>/dev/null || true)"
    want="$(pinned LID_SHA256 "$LID_SHA256")"
    if [ "$got" = "$want" ]; then
      chk ok language-id "models/lid.176.ftz, sha256 $(short "$got") as pinned"
    else
      chk FAIL language-id "models/lid.176.ftz is sha256 $(short "$got"), the pinned model is $(short "$want")"
      fix "remove it and run: $ANAGRAM_HOME/bin/anagram model"
    fi
  fi
}

doctor_disk() {
  free_kb="$(df -Pk "$ANAGRAM_HOME" 2>/dev/null | awk 'NR == 2 { print $4 }' || true)"
  case "$free_kb" in
    ""|*[!0-9]*) chk warn disk "could not read the free space of this filesystem"; return 0 ;;
  esac
  tenths=$((free_kb * 10 / 1048576))
  human="$((tenths / 10)).$((tenths % 10)) GB"
  if [ "$free_kb" -lt 1048576 ]; then
    chk warn disk "only $human free where $ANAGRAM_HOME lives — an update needs about 2 GB"
  else
    chk ok disk "$human free on the filesystem holding this folder"
  fi
}

doctor_daemon() {
  health="$(curl -fsS -m 3 "$HEALTH" 2>/dev/null || true)"
  contract="$(json_str "$health" contract)"
  if [ -n "$contract" ]; then
    lid="$(json_str "$health" lid)"
    detail="$(json_str "$health" id) $(json_str "$health" ver) · $(json_str "$health" device) $(json_str "$health" dtype)"
    detail="$detail · language gate ${lid:-OFF} · contract $contract"
    if [ "${contract%%.*}" != "$CONTRACT_MAJOR" ]; then
      chk FAIL daemon "answering on 127.0.0.1:$PORT with contract $contract; the extension here speaks $CONTRACT_MAJOR.x"
      fix "run: $ANAGRAM_HOME/bin/anagram update"
      note "$detail"
    else
      chk ok daemon "answering on 127.0.0.1:$PORT — $detail"
    fi
    if ! alive; then
      note "(answering, but not started by 'anagram start' — no live pid in ${PIDFILE#"$ANAGRAM_HOME"/})"
    fi
    return 0
  fi

  if port_busy; then
    chk FAIL port "something is listening on 127.0.0.1:$PORT and it does not answer /health as anagramd does"
    if command -v lsof >/dev/null 2>&1; then
      lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | sed -n '1,4p' | sed 's/^/      /' || true
    else
      note "(install lsof to see which program that is)"
    fi
    fix "stop that program, or set another PORT in $ANAGRAM_HOME/config and run: $ANAGRAM_HOME/bin/anagram restart"
  elif alive; then
    chk warn daemon "pid $(cat "$PIDFILE") is alive but not answering yet — it is probably still loading the model"
    fix "watch it come up: $ANAGRAM_HOME/bin/anagram logs"
  elif [ -f "$PIDFILE" ]; then
    chk FAIL daemon "stale pid file ${PIDFILE#"$ANAGRAM_HOME"/}: pid $(cat "$PIDFILE" 2>/dev/null) is gone and nothing is listening on $PORT"
    fix "run: $ANAGRAM_HOME/bin/anagram start  (it takes the file over)"
  else
    chk warn daemon "not running — nothing is listening on 127.0.0.1:$PORT"
    fix "run: $ANAGRAM_HOME/bin/anagram start"
  fi
  # Whatever the reason, the daemon is not answering: its own last words are the next thing
  # anyone would ask for.
  if [ -f "$LOG" ] && [ ! -L "$LOG" ]; then
    printf '\nlast lines of %s:\n' "$LOG"
    tail -n 12 "$LOG" 2>/dev/null | sed 's/^/      /' || true
  else
    printf '\n(no log yet at %s)\n' "$LOG"
  fi
}

cmd_doctor() {
  printf 'anagram doctor — %s\n\n' "$ANAGRAM_HOME"
  doctor_folder
  doctor_version
  doctor_python
  doctor_models
  doctor_disk
  doctor_daemon
  printf '\n'
  if [ "$DOCTOR_FAILED" -eq 0 ]; then
    if [ "$DOCTOR_WARNED" -eq 1 ]; then
      say "nothing broken — the warn line above is worth a look"
    elif [ "$DOCTOR_WARNED" -gt 1 ]; then
      say "nothing broken — the $DOCTOR_WARNED warn lines above are worth a look"
    else
      say "nothing wrong found"
    fi
    return 0
  fi
  printf '%s%d check(s) FAILED%s — the lines above say what to run.\n' "$C_R" "$DOCTOR_FAILED" "$C_0"
  return 1
}

# ---------------------------------------------------------------------------- update
# The installer replaces app/ under a running daemon, which keeps serving the OLD code from
# memory until somebody restarts it. So: remember whether OUR daemon was up (a live pid in our
# own pid file AND /health answering), run the installer exactly as before, and restart only
# what we ourselves saw running. If the installer fails, the running daemon is not touched —
# a half-finished update is no reason to take the working thing away.
cmd_update() {
  was_running=0
  if alive && healthy; then was_running=1; fi
  rc=0
  installer="$ANAGRAM_HOME/app/install.sh"
  if [ -f "$installer" ]; then
    ANAGRAM_HOME="$ANAGRAM_HOME" sh "$installer" || rc=$?
  else
    curl -fsSL https://github.com/CoderBak/anagram/releases/latest/download/install.sh \
      | ANAGRAM_HOME="$ANAGRAM_HOME" sh || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    if [ "$was_running" -eq 1 ]; then
      die "the installer failed (exit $rc) — the daemon that was running has been left alone, still serving the code it already has"
    fi
    die "the installer failed (exit $rc) — nothing was started or stopped"
  fi
  if [ "$was_running" -eq 0 ]; then
    say "The daemon was not running — start it with: $ANAGRAM_HOME/bin/anagram start"
    return 0
  fi
  say "Restarting the daemon so the code that runs is the code just installed"
  cmd_stop || true
  cmd_start
}

cmd_uninstall() {
  # Re-validate right before the one destructive command in this program.
  is_anagram_home "$ANAGRAM_HOME" || die "'$ANAGRAM_HOME' is not an Anagram folder — nothing removed"
  case "$ANAGRAM_HOME" in "${HOME:-/nonexistent}"|/) die "refusing";; esac
  if [ "${1:-}" != "-y" ]; then
    [ -t 0 ] || die "not an interactive terminal — pass -y to remove $ANAGRAM_HOME"
    printf 'Remove %s and everything in it (the daemon, its Python, the model, the extension)? [y/N] ' "$ANAGRAM_HOME"
    read -r ans; case "$ans" in y|Y|yes) ;; *) echo "kept"; return 0;; esac
  fi
  cmd_stop || true
  rm -rf "$ANAGRAM_HOME"
  say "Removed $ANAGRAM_HOME. Nothing else was ever installed. Remove the unpacked extension from chrome://extensions."
}

case "${1:-}" in
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_stop || true; cmd_start ;;
  status)   cmd_status ;;
  doctor)   cmd_doctor ;;
  logs)     exec tail -n 50 -f "$LOG" ;;
  selftest) clean_env HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 "$PY" "$APP" --model-dir "$MODEL_DIR" --lid-model "$LID" --selftest ;;
  model)    cmd_model ;;
  path)     echo "$ANAGRAM_HOME/extension" ;;
  version)  cmd_version ;;
  # `exit` on purpose: the installer rewrites this very file in place, and a shell that
  # returned here would read its next command from a byte offset in the NEW file.
  update)   cmd_update; exit $? ;;
  uninstall) cmd_uninstall "${2:-}" ;;
  *) cat <<USAGE
anagram — the Anagram scoring daemon in $ANAGRAM_HOME

  anagram start       start the daemon in the background (127.0.0.1:$PORT)
  anagram stop        stop it
  anagram restart
  anagram status      is it running, which model, how many paragraphs scored
  anagram doctor      check this folder, the Python, the models, the port — and say what is
                      wrong and what to run; changes nothing
  anagram logs        follow the log
  anagram selftest    score four sample paragraphs (one Chinese → unsupported) and exit
  anagram model       (re)download the EditLens checkpoint
  anagram path        print the folder to "Load unpacked" in chrome://extensions
  anagram version     the installed version, and whether the running daemon is that build
  anagram update      re-run the installer (updates in place) and restart a running daemon
  anagram uninstall   remove $ANAGRAM_HOME — the only thing the installer created (-y to skip the prompt)
USAGE
  ;;
esac
