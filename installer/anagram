#!/bin/sh
# Maintenance commands for the browser-owned Native Messaging component.
set -eu
MARKER=".anagram-home"
say() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
# Resolve this script's real path (through symlinks) without GNU readlink -f.
self="$0"
n=0
while [ -L "$self" ] && [ $n -lt 16 ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
  n=$((n + 1))
done
SELF_HOME="$(cd "$(dirname "$self")/.." 2>/dev/null && pwd -P)"

is_anagram_home() {
  [ -n "$1" ] && [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/$MARKER" ]
}
if [ -n "${ANAGRAM_HOME:-}" ]; then
  is_anagram_home "$ANAGRAM_HOME" || die "ANAGRAM_HOME='$ANAGRAM_HOME' is not an Anagram folder (no $MARKER, or a symlink) — refusing to use it"
else
  ANAGRAM_HOME="$SELF_HOME"
  is_anagram_home "$ANAGRAM_HOME" || die "this script is not inside an Anagram folder ($ANAGRAM_HOME has no $MARKER)"
fi
case "$ANAGRAM_HOME" in
  /*) ;;
  *) die "ANAGRAM_HOME must be absolute" ;;
esac
case "$ANAGRAM_HOME" in
  "${HOME:-/nonexistent}"|/|/usr|/usr/local|/opt|/etc|/var|/tmp|/private/tmp|/Users|/home|/Applications|/Library|/System)
    die "refusing to operate on '$ANAGRAM_HOME'" ;;
esac


case "/$ANAGRAM_HOME/" in */../*|*/./*) die "ANAGRAM_HOME must not contain . or .. segments" ;; esac
[ ! -L "$ANAGRAM_HOME/$MARKER" ] || die "installation marker must not be a symbolic link"
for sub in app bin models venv python hf cache logs run .native-component.json .native-uninstall.json native-registration.json; do
  [ ! -L "$ANAGRAM_HOME/$sub" ] || die "symbolic link in installation: $sub"
done
PY="$ANAGRAM_HOME/venv/bin/python"
MODEL_DIR="$ANAGRAM_HOME/models/editlens_roberta-large"
LID="$ANAGRAM_HOME/models/lid.176.ftz"
clean_env() {
  env -i HOME="$HOME" PATH="/usr/bin:/bin:/usr/sbin:/sbin" LANG="${LANG:-C.UTF-8}" \
    HF_HOME="$ANAGRAM_HOME/hf" HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 XDG_CACHE_HOME="$ANAGRAM_HOME/cache" \
    TOKENIZERS_PARALLELISM=false PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 \
    ${http_proxy:+http_proxy="$http_proxy"} ${https_proxy:+https_proxy="$https_proxy"} ${no_proxy:+no_proxy="$no_proxy"} \
    ${HTTP_PROXY:+HTTP_PROXY="$HTTP_PROXY"} ${HTTPS_PROXY:+HTTPS_PROXY="$HTTPS_PROXY"} ${NO_PROXY:+NO_PROXY="$NO_PROXY"} \
    ${SSL_CERT_FILE:+SSL_CERT_FILE="$SSL_CERT_FILE"} ${REQUESTS_CA_BUNDLE:+REQUESTS_CA_BUNDLE="$REQUESTS_CA_BUNDLE"} \
    "$@"
}

# An installer records its process ID in its lock. The lock of one that died keeps the
# host out until another installer takes it over and recovers the folder.
installer_died() {
  lock="$ANAGRAM_HOME/.installer-lock"
  [ -d "$lock" ] && [ ! -L "$lock" ] && [ -f "$lock/pid" ] && [ ! -L "$lock/pid" ] || return 1
  pid="$(cat "$lock/pid")"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  ! kill -0 "$pid" 2>/dev/null
}

maintenance() {
  [ -x "$PY" ] && [ -f "$ANAGRAM_HOME/app/native_registration.py" ] && [ -f "$ANAGRAM_HOME/.native-component.json" ] || die "Native maintenance helper or ownership marker is missing; reinstall the component before retrying"
  if installer_died; then
    # The helper takes the host lock itself before maintenance.
    clean_env "$PY" -I "$ANAGRAM_HOME/app/native_registration.py" "$1" --home "$ANAGRAM_HOME"
    return
  fi
  clean_env "$PY" -I -B - "$ANAGRAM_HOME" "$1" <<'PYEOF'
import subprocess, sys
from pathlib import Path
home = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(home / "app"))
from native_component import ComponentError, HomeLock, validate_home
try:
    lock = HomeLock(validate_home(home))
except ComponentError as exc:
    sys.exit(exc.message)
try:
    fd = lock.maintenance_fd()
    helper = subprocess.Popen([sys.executable, "-I", str(home / "app/native_registration.py"), sys.argv[2],
                               "--lock-fd", str(fd), "--home", str(home)], pass_fds=(fd,))
    # Ctrl-C reaches the helper and its installer too. Wait for the installer's rollback;
    # subprocess.run would kill the helper a quarter of a second into it.
    while helper.returncode is None:
        try:
            helper.wait()
        except KeyboardInterrupt:
            pass
    sys.exit(helper.returncode)
finally:
    lock.close()
PYEOF
}

# The fallback is needed only if removal already reached the private interpreter.
# Read data, never shell commands, from the receipt recorded before that phase.
finish_without_python() {
  digest=$1
  case "$digest" in ''|*[!0-9a-f]*) die "invalid recovery receipt digest" ;; esac
  [ "${#digest}" -eq 64 ] || die "invalid recovery receipt digest"
  plan="$real/.anagram-removal-$digest.tsv"
  [ -f "$plan" ] && [ ! -L "$plan" ] || die "recovery receipt missing; remaining files are in $real"
  if command -v sha256sum >/dev/null 2>&1; then sha=sha256sum; else sha='shasum -a 256'; fi
  file_hash() { $sha < "$1" | cut -d' ' -f1; }
  [ "$(file_hash "$plan")" = "$digest" ] || die "recovery receipt changed; remaining files are in $real"
  # Keep the recovery command usable if a later file is locked.
  cli_hash=''
  tab=$(printf '\t')
  while IFS="$tab" read -r sig name; do
    case "/$name/" in *'//'*|*'/../'*|*'/./'*) die "invalid path in recovery receipt" ;; esac
    case "$name" in
      bin/anagram) cli_hash="$sig"; continue ;;
      python|python/*|venv|venv/*|app/native_registration.py|app/.anagram-installed-files.json|native-registration.json|.anagram-removal.json) ;;
      *) die "unexpected recovery receipt entry" ;;
    esac
    file="$real/$name"
    [ -e "$file" ] || [ -L "$file" ] || continue
    parent=${file%/*}
    plain=1
    while [ "$parent" != "$real" ]; do
      if [ -L "$parent" ] || [ ! -d "$parent" ]; then plain=0; break; fi
      if command -v mountpoint >/dev/null 2>&1; then
        if mountpoint -q "$parent"; then plain=0; break; fi
      elif [ "$(stat -f %d "$parent")" != "$(stat -f %d "$real")" ]; then plain=0; break
      fi
      parent=${parent%/*}
    done
    [ "$plain" -eq 1 ] || continue
    case "$sig" in
      dir) [ -L "$file" ] || rmdir "$file" 2>/dev/null || : ;;
      link:*) if [ -L "$file" ] && [ "$(readlink "$file")" = "${sig#link:}" ]; then rm "$file"; fi ;;
      *) if [ ! -L "$file" ] && [ -f "$file" ] && [ "$(file_hash "$file")" = "$sig" ]; then rm "$file"; fi ;;
    esac
  done < "$plan"
  if [ -n "$cli_hash" ] && [ ! -L "$real/bin/anagram" ] && [ -f "$real/bin/anagram" ] &&
     [ "$(file_hash "$real/bin/anagram")" = "$cli_hash" ]; then rm "$real/bin/anagram"; fi
  if [ -f "$real/.native-host.lock" ] && [ ! -L "$real/.native-host.lock" ] && [ ! -s "$real/.native-host.lock" ]; then rm "$real/.native-host.lock"; fi
  rm "$plan" "$real/.native-uninstall.json"
  if [ -f "$real/$MARKER" ] && [ ! -L "$real/$MARKER" ]; then
    case "$(cat "$real/$MARKER")" in "Anagram installation: $real"|"Anagram installation folder."|"Anagram installation folder. Safe to delete with: bin/anagram uninstall") rm "$real/$MARKER" ;; esac
  fi
  for sub in app bin native models hf cache run; do rmdir "$real/$sub" 2>/dev/null || :; done
  rmdir "$real" 2>/dev/null || say "Unverified files were kept in $real"
}

finish_uninstall() {
  { [ ! -e "$ANAGRAM_HOME/.installer-lock" ] && [ ! -L "$ANAGRAM_HOME/.installer-lock" ]; } || installer_died || die "an installer is using $ANAGRAM_HOME; retry after it finishes"
  real="$(cd "$ANAGRAM_HOME" && pwd -P)"
  retired="$real/.native-uninstall.json"
  digest=$(sed -n 's/^  "recovery_sha256": "\([a-f0-9]*\)",$/\1/p' "$retired")
  if [ -n "$digest" ]; then
    if command -v sha256sum >/dev/null 2>&1; then sha=sha256sum; else sha='shasum -a 256'; fi
    home_sha=$(printf '%s' "$real" | $sha | cut -d' ' -f1)
    grep -qxF "  \"recovery_home_sha256\": \"$home_sha\"," "$retired" || die "recovery receipt belongs to another folder"
    finish_without_python "$digest"
  elif [ -x "$PY" ] && [ -f "$real/app/native_registration.py" ] && [ -f "$real/.anagram-removal.json" ]; then
    clean_env "$PY" -I "$real/app/native_registration.py" finish-removal --home "$real"
  else
  quoted_home="$(printf '%s' "$real" | sed 's/["\\]/\\&/g')"
  grep -qxF "  \"home\": \"$quoted_home\"" "$retired" || die "the uninstall marker does not name $real"
    say "Browser registration already removed. Remaining files preserved in $real"
  fi
}

case "${1:-}" in
  download)
    [ -x "$PY" ] || die "Private Python is missing; reinstall the component"
    ! installer_died || die "an installation was interrupted; repair $ANAGRAM_HOME with: anagram update"
    shift
    profile=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --profile) [ $# -ge 2 ] || die "--profile needs recommended or expanded"; profile="$2"; shift 2 ;;
        --profile=*) profile="${1#--profile=}"; shift ;;
        *) die "unknown download option: $1" ;;
      esac
    done
    case "$profile" in ""|recommended|expanded) ;; *) die "--profile must be recommended or expanded" ;; esac
    clean_env "$PY" -I "$ANAGRAM_HOME/app/prepare_models.py" --home "$ANAGRAM_HOME" --language "${ANAGRAM_LANG:-en}" ${profile:+--profile "$profile"}
    ;;
  doctor)
    [ -x "$PY" ] || die "Private Python is missing; reinstall the component"
    ! installer_died || die "an installation was interrupted; repair $ANAGRAM_HOME with: anagram update"
    [ -f "$ANAGRAM_HOME/app/native_host.py" ] && [ -f "$ANAGRAM_HOME/app/engine.py" ] || die "Native engine files are missing; reinstall the component"
    clean_env "$PY" -I -B - "$ANAGRAM_HOME" <<'PYEOF'
import os, runpy, sys
from pathlib import Path
home = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(home / 'app'))
from native_component import HomeLock, validate_home
from native_host import configure_environment
lock = HomeLock(validate_home(home))
try:
    os.chdir(home)
    configure_environment(home)
    from detector import selected, model_dir
    from download_modelkit import invalid_files, matches, LID_ENTRY
    pin = selected(home)
    bad = invalid_files(model_dir(home, pin), pin)
    if bad or not matches(home / "models/lid.176.ftz", LID_ENTRY):
        raise SystemExit("Detector files need repair. Run anagram download.")
    print(pin["release"], pin["revision"])
finally:
    lock.close()
PYEOF
    say "Installed detector verified."
    ;;
  version) [ -f "$ANAGRAM_HOME/VERSION" ] || die "Installed version is missing"; cat "$ANAGRAM_HOME/VERSION" ;;
  path) printf '%s\n' "$ANAGRAM_HOME/extension" ;;
  update) maintenance update; exit $? ;;
  uninstall)
    if [ "${2:-}" != -y ]; then
      [ -t 0 ] || die "not an interactive terminal — pass -y to remove $ANAGRAM_HOME"
      printf 'Remove %s and its registered local component? [y/N] ' "$ANAGRAM_HOME"
      read -r answer
      case "$answer" in y|Y|yes) ;; *) exit 0 ;; esac
    fi
    if [ ! -e "$ANAGRAM_HOME/.native-component.json" ] && [ -f "$ANAGRAM_HOME/.native-uninstall.json" ]; then
      finish_uninstall
    else
      maintenance uninstall
    fi
    ;;
  *)
    cat <<USAGE
Usage: anagram download [--profile recommended|expanded] | doctor | version | path | update | uninstall [-y]

The browser starts the local component. Use Anagram Settings to pause downloads,
stop/resume the engine, change its configuration, or remove models.
Close the browser's component connection before terminal download, update or uninstall.
USAGE
    [ -z "${1:-}" ] || exit 2
    ;;
esac
