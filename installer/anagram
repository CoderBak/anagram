#!/bin/sh
# Maintenance commands for the browser-owned Native Messaging component.
set -eu
MARKER=".anagram-home"
say() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
# Resolve this script's real path (through symlinks) without GNU readlink -f.
self="$0"
n=0
while [ -L "$self" ] && [ $n -lt 16 ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
  n=$((n + 1))
done
SELF_HOME="$(cd "$(dirname "$self")/.." 2>/dev/null && pwd -P)"

is_anagram_home() {
  [ -n "$1" ] && [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/$MARKER" ]
}
if [ -n "${ANAGRAM_HOME:-}" ]; then
  is_anagram_home "$ANAGRAM_HOME" || die "ANAGRAM_HOME='$ANAGRAM_HOME' is not an Anagram folder (no $MARKER, or a symlink) — refusing to use it"
else
  ANAGRAM_HOME="$SELF_HOME"
  is_anagram_home "$ANAGRAM_HOME" || die "this script is not inside an Anagram folder ($ANAGRAM_HOME has no $MARKER)"
fi
case "$ANAGRAM_HOME" in
  /*) ;;
  *) die "ANAGRAM_HOME must be absolute" ;;
esac
case "$ANAGRAM_HOME" in
  "${HOME:-/nonexistent}"|/|/usr|/usr/local|/opt|/etc|/var|/tmp|/private/tmp|/Users|/home|/Applications|/Library|/System)
    die "refusing to operate on '$ANAGRAM_HOME'" ;;
esac


case "/$ANAGRAM_HOME/" in */../*|*/./*) die "ANAGRAM_HOME must not contain . or .. segments" ;; esac
[ ! -L "$ANAGRAM_HOME/$MARKER" ] || die "installation marker must not be a symbolic link"
for sub in app bin models venv python hf cache logs run .native-component.json native-registration.json; do
  [ ! -L "$ANAGRAM_HOME/$sub" ] || die "symbolic link in installation: $sub"
done
PY="$ANAGRAM_HOME/venv/bin/python"
MODEL_DIR="$ANAGRAM_HOME/models/editlens_roberta-large"
LID="$ANAGRAM_HOME/models/lid.176.ftz"
clean_env() {
  env -i HOME="$HOME" PATH="/usr/bin:/bin:/usr/sbin:/sbin" LANG="${LANG:-C.UTF-8}" \
    HF_HOME="$ANAGRAM_HOME/hf" HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 XDG_CACHE_HOME="$ANAGRAM_HOME/cache" \
    TOKENIZERS_PARALLELISM=false PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 \
    ${http_proxy:+http_proxy="$http_proxy"} ${https_proxy:+https_proxy="$https_proxy"} ${no_proxy:+no_proxy="$no_proxy"} \
    ${HTTP_PROXY:+HTTP_PROXY="$HTTP_PROXY"} ${HTTPS_PROXY:+HTTPS_PROXY="$HTTPS_PROXY"} ${NO_PROXY:+NO_PROXY="$NO_PROXY"} \
    ${SSL_CERT_FILE:+SSL_CERT_FILE="$SSL_CERT_FILE"} ${REQUESTS_CA_BUNDLE:+REQUESTS_CA_BUNDLE="$REQUESTS_CA_BUNDLE"} \
    "$@"
}

maintenance() {
  [ -x "$PY" ] && [ -f "$ANAGRAM_HOME/app/native_registration.py" ] && [ -f "$ANAGRAM_HOME/.native-component.json" ] || die "Native maintenance helper or ownership marker is missing; reinstall the component before retrying"
  clean_env "$PY" -I - "$ANAGRAM_HOME" "$1" <<'PYEOF'
import subprocess, sys
from pathlib import Path
home = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(home / "app"))
from native_component import ComponentError, HomeLock, validate_home
try:
    lock = HomeLock(validate_home(home))
except ComponentError as exc:
    sys.exit(exc.message)
try:
    fd = lock.maintenance_fd()
    subprocess.run([sys.executable, "-I", str(home / "app/native_registration.py"), sys.argv[2],
                    "--lock-fd", str(fd), "--home", str(home)], pass_fds=(fd,), check=True)
finally:
    lock.close()
PYEOF
}

case "${1:-}" in
  doctor)
    [ -x "$PY" ] || die "Private Python is missing; reinstall the component"
    [ -f "$ANAGRAM_HOME/app/native_host.py" ] && [ -f "$ANAGRAM_HOME/app/engine.py" ] || die "Native engine files are missing; reinstall the component"
    clean_env PYTHONDONTWRITEBYTECODE=1 "$PY" -I - "$ANAGRAM_HOME" <<'PYEOF'
import os, runpy, sys
from pathlib import Path
home = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(home / 'app'))
from native_component import HomeLock, validate_home
from native_host import configure_environment
lock = HomeLock(validate_home(home))
try:
    os.chdir(home)
    configure_environment(home)
    script = home / 'app/download_modelkit.py'
    sys.argv = [str(script), '--model-dir', str(home / 'models/editlens_roberta-large'),
                '--lid-model', str(home / 'models/lid.176.ftz'), '--profile', 'installed']
    runpy.run_path(str(script), run_name='__main__')
finally:
    lock.close()
PYEOF
    say "Installed model plan verified. Open Anagram Settings for preparation status and optional expanded comparison models."
    ;;
  version) [ -f "$ANAGRAM_HOME/VERSION" ] || die "Installed version is missing"; cat "$ANAGRAM_HOME/VERSION" ;;
  path) printf '%s\n' "$ANAGRAM_HOME/extension" ;;
  update) maintenance update; exit $? ;;
  uninstall)
    if [ "${2:-}" != -y ]; then
      [ -t 0 ] || die "not an interactive terminal — pass -y to remove $ANAGRAM_HOME"
      printf 'Remove %s and its registered local component? [y/N] ' "$ANAGRAM_HOME"
      read -r answer
      case "$answer" in y|Y|yes) ;; *) exit 0 ;; esac
    fi
    maintenance uninstall
    ;;
  *)
    cat <<USAGE
Usage: anagram doctor | version | path | update | uninstall [-y]

The browser starts the local component. Use Anagram Settings to pause downloads,
stop/resume the engine, change its configuration, or remove models.
Close the browser's component connection before terminal update or uninstall.
USAGE
    [ -z "${1:-}" ] || exit 2
    ;;
esac
